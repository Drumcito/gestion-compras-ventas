# La base de datos vive en el hosting, no en el repo: esquema, datos y
# respaldos se quedan fuera. Las migraciones si van al repo: son los cambios de
# estructura que hay que correr tambien en produccion, y si no se versionan pasa
# lo que paso con usuarios.debe_cambiar_password (codigo desplegado sin su
# columna, login roto). Son de texto y pesan unos KB.
database/*
!database/migraciones/
!database/.htaccess
*.sql.zip
*.dump


# Archivos de los proveedores (fuente de la importación)
*.xlsx
*.xls

# Locales
.vscode/
.idea/
Thumbs.db
desktop.ini

# Credenciales reales (nunca se suben): .local en tu maquina, .prod en el servidor
app/config/credenciales.local.php
config/credenciales.local.php
config/credenciales.prod.php
crear_usuarios.php
app/config/seed/consultas.sql
app/config/migrations/gabe_system_hosting.sql
# Herramienta local para generar hashes (nunca al servidor)
generar_hash.php

# Config de correo real (nunca se sube)
config/smtp.local.php
config/smtp.prod.php

# Notas PDF generadas al vuelo (no se versionan)
public/notas/
